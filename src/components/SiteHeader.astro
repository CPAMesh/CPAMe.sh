---
const { base = "" } = Astro.props;
---
  <header>
    <div class="container header-inner">
      <a href={base || "/"} class="logo">
        <img src="/logo.jpg" alt="Central PA Mesh Logo - Meshcore and LoRa network in Pennsylvania" />
        <div class="logo-text">
          CENTRAL PA<br>
          <span>MESH</span>
        </div>
      </a>
      <nav>
        <a href={base + "#about"}>About</a>
        <a href={base + "#get-started"}>Get Started</a>
        <a href={base + "#resources"}>Resources</a>
        <a href={base + "#map"}>Coverage Map</a>
        <a href="/regions">Regions</a>
        <a href={base + "#hardware"}>Hardware</a>
        <a href="https://discord.gg/9wWs3Y7Cx5" class="icon-btn discord-btn" target="_blank" rel="noopener" aria-label="Join Discord">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
          Discord
        </a>
        <a href="https://www.facebook.com/share/g/1E1nHxfQyd/" class="icon-btn facebook-btn" target="_blank" rel="noopener" aria-label="Join Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
      </nav>
      <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <div class="drawer-backdrop" data-drawer-close hidden></div>
  <aside id="mobile-drawer" class="drawer" aria-label="Site menu" aria-hidden="true" inert>
    <div class="drawer-head">
      <span class="logo-text">CENTRAL PA <span>MESH</span></span>
      <button class="drawer-close" type="button" aria-label="Close menu" data-drawer-close>&times;</button>
    </div>
    <div class="drawer-links"></div>
  </aside>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.querySelector('.drawer-backdrop');
  const links = drawer.querySelector('.drawer-links');
  // Reuse the header nav links so there is one source of truth.
  document.querySelectorAll('header nav > a').forEach((a) => links.appendChild(a.cloneNode(true)));

  const setOpen = (open) => {
    drawer.classList.toggle('open', open);
    backdrop.hidden = !open;
    requestAnimationFrame(() => backdrop.classList.toggle('open', open));
    drawer.toggleAttribute('inert', !open);
    drawer.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('drawer-open', open);
    (open ? drawer.querySelector('.drawer-close') : toggle).focus();
  };

  toggle.addEventListener('click', () => setOpen(true));
  document.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => setOpen(false)));
  links.addEventListener('click', (e) => { if (e.target.closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer.classList.contains('open')) setOpen(false); });
  matchMedia('(min-width: 701px)').addEventListener('change', (e) => { if (e.matches && drawer.classList.contains('open')) setOpen(false); });

  // Shareable section links: keep the URL hash in sync with the section in view,
  // and re-scroll to a shared #section after late content (map, widgets) loads.
  (() => {
    const ids = ['about','discord','map','get-started','resources','hardware'];
    const secs = ids.map((id) => document.getElementById(id)).filter(Boolean);
    if (!secs.length) return;
    const fromPath = () => {
      const id = location.pathname.replace(/^\/|\/$/g, '');
      return ids.includes(id) ? id : '';
    };
    const goTo = () => {
      const id = fromPath() || location.hash.slice(1);
      const el = id && document.getElementById(id);
      if (el) el.scrollIntoView();
    };
    if (fromPath() || location.hash) {
      window.addEventListener('load', () => { goTo(); setTimeout(goTo, 800); });
      goTo();
    }
    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY + 120;
      let current = '';
      for (const s of secs) if (s.offsetTop <= y) current = s.id;
      if (window.scrollY < 80) current = '';
      const want = current ? '/' + current : '/';
      if (location.pathname.replace(/\/$/, '') !== (current ? '/' + current : '') || location.hash) {
        history.replaceState(null, '', want + location.search);
      }
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
  })();
</script>
